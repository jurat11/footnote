# Required: the SEC blocks requests without a descriptive User-Agent contact.
SEC_CONTACT_EMAIL=you@example.com

# Report writer engine: template (default, $0) | gemini (free tier) | ollama (local, $0) | anthropic (paid)
FOOTNOTE_ENGINE=template

# Free-tier Gemini engine. Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.6-flash

# Only used by the ollama engine.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Only used by the anthropic engine. Leave unset to run at zero API cost.
# ANTHROPIC_API_KEY=sk-ant-...
FOOTNOTE_MODEL=claude-sonnet-4-5
